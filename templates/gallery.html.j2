{% extends "base.html.j2" %}
{% block body %}
<div class="page-header"><h1>{{ page_h1 }}</h1></div>
<main class="content" id="main">
  <div class="gallery">
    {% for n in gallery %}
    {% set num = '%02d' % n %}
    <a class="gallery-item" href="{{ asset }}images/gallery/{{ num }}.webp">
      <img src="{{ asset }}images/gallery/{{ num }}_thumb.webp" alt="{{ site_name }}" loading="lazy" width="640" height="427">
    </a>
    {% endfor %}
  </div>
</main>
{% endblock %}
{% block scripts %}
<script>
/* Minimal lightbox with prev/next. Without JS the links still open the full-size image. */
(function () {
  var items = Array.prototype.slice.call(document.querySelectorAll('.gallery-item'));
  if (!items.length) return;
  var box = document.createElement('div');
  box.className = 'lightbox';
  box.innerHTML =
    '<button class="lightbox-close" aria-label="X">&times;</button>' +
    '<button class="lightbox-nav lightbox-prev" aria-label="<">&#10094;</button>' +
    '<img alt="">' +
    '<button class="lightbox-nav lightbox-next" aria-label=">">&#10095;</button>';
  document.body.appendChild(box);
  var img = box.querySelector('img');
  var current = 0;
  function show(i) {
    current = (i + items.length) % items.length;
    img.src = items[current].getAttribute('href');
    box.classList.add('open');
  }
  function close() { box.classList.remove('open'); img.removeAttribute('src'); }
  items.forEach(function (a, i) {
    a.addEventListener('click', function (e) { e.preventDefault(); show(i); });
  });
  box.querySelector('.lightbox-prev').addEventListener('click', function () { show(current - 1); });
  box.querySelector('.lightbox-next').addEventListener('click', function () { show(current + 1); });
  box.querySelector('.lightbox-close').addEventListener('click', close);
  box.addEventListener('click', function (e) { if (e.target === box) close(); });
  document.addEventListener('keydown', function (e) {
    if (!box.classList.contains('open')) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft') show(current - 1);
    else if (e.key === 'ArrowRight') show(current + 1);
  });
})();
</script>
{% endblock %}
