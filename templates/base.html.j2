<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ page_desc }}">
  <link rel="canonical" href="{{ page_url }}">
  {% for alt in hreflang_links %}
  <link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ alt.href }}">
  {% endfor %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site_name }}">
  <meta property="og:title" content="{{ page_title }}">
  <meta property="og:description" content="{{ page_desc }}">
  <meta property="og:url" content="{{ page_url }}">
  <meta property="og:image" content="{{ base_url }}/images/og-image.jpg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="{{ og_locale }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="stylesheet" href="{{ asset }}css/style.css?v={{ css_version }}">
  <link rel="icon" type="image/png" href="{{ asset }}images/favicon.png">
</head>
<body>
  <a class="skip-link" href="#main">{{ t.skip_to_content }}</a>
  <header class="site-header">
    <div class="header-inner">
      <a href="index.html" class="logo">
        <img src="{{ asset }}images/logo-mark.webp" alt="">
        <span class="logo-text">
          <span class="logo-name">{{ site_name }}</span>
          <span class="logo-tagline">{{ tagline }}</span>
        </span>
      </a>
      <div class="header-right">
        <button class="nav-toggle" aria-label="{{ t.menu }}" aria-expanded="false"
          onclick="var n=document.querySelector('.main-nav');var o=n.classList.toggle('open');this.setAttribute('aria-expanded',o)">&#9776;</button>
        <nav class="main-nav" aria-label="{{ t.menu }}">
          <ul>
            {% for item in nav %}
            <li{% if item.divider %} class="nav-divider"{% endif %}><a href="{{ item.file }}"{% if item.active %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        </nav>
        <div class="lang-switch" aria-label="Language">
          {% for L in lang_links %}
          {% if not loop.first %}<span aria-hidden="true">/</span>{% endif %}
          <a href="{{ L.href }}"{% if L.active %} class="active"{% endif %} hreflang="{{ L.code }}" lang="{{ L.code }}" title="{{ L.title }}">{{ L.code | upper }}</a>
          {% endfor %}
        </div>
      </div>
    </div>
  </header>

  {% block body %}{% endblock %}

  <footer class="site-footer">
    <img class="footer-logo" src="{{ asset }}images/{{ footer_logo }}" alt="{{ site_name }} – {{ tagline }}" loading="lazy" height="110">
    <p class="footer-links">
      {% for link in footer_links %}
      <a href="{{ link.file }}">{{ link.label }}</a>
      {% endfor %}
    </p>
    <p>&copy; {{ year }} {{ t.footer }}</p>
  </footer>
  {% block scripts %}{% endblock %}
</body>
</html>
