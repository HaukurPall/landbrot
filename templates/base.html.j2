<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ page_title }}</title>
  <meta name="description" content="{{ page_desc }}">
  {% for alt in hreflang_links %}
  <link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ alt.href }}">
  {% endfor %}
  <link rel="stylesheet" href="{{ asset }}css/style.css">
  <link rel="icon" href="{{ asset }}images/logo.jpg">
</head>
<body>
  <a class="skip-link" href="#main">{{ t.skip_to_content }}</a>
  <header class="site-header">
    <div class="header-inner">
      <a href="index.html" class="logo">
        <img src="{{ asset }}images/{{ logo_file }}" alt="{{ site_name }} – {{ tagline }}">
      </a>
      <div class="header-right">
        <button class="nav-toggle" aria-label="{{ t.menu }}" aria-expanded="false"
          onclick="var n=document.querySelector('.main-nav');var o=n.classList.toggle('open');this.setAttribute('aria-expanded',o)">&#9776;</button>
        <nav class="main-nav" aria-label="{{ t.menu }}">
          <ul>
            {% for item in nav %}
            <li><a href="{{ item.file }}"{% if item.active %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a></li>
            {% endfor %}
          </ul>
        </nav>
        <div class="lang-switch" aria-label="Language">
          <a href="{{ lang_is_href }}"{% if lang == 'is' %} class="active"{% endif %} hreflang="is" lang="is" title="{{ t.lang_is }}">IS</a>
          <span aria-hidden="true">/</span>
          <a href="{{ lang_de_href }}"{% if lang == 'de' %} class="active"{% endif %} hreflang="de" lang="de" title="{{ t.lang_de }}">DE</a>
        </div>
      </div>
    </div>
  </header>

  {% block body %}{% endblock %}

  <footer class="site-footer">
    <p>&copy; {{ year }} {{ t.footer }}</p>
  </footer>
  {% block scripts %}{% endblock %}
</body>
</html>
